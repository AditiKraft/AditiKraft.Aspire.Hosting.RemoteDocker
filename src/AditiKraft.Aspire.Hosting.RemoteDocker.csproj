<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <IsAspireHostingPackage>true</IsAspireHostingPackage>
    <PackageId>AditiKraft.Aspire.Hosting.RemoteDocker</PackageId>
    <Version>0.0.1</Version>
    <Authors>AditiKraft</Authors>
    <Description>Aspire hosting extension for SSH port forwarding to remote Docker hosts.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" Version="13.4.6" />
    <PackageReference Include="SSH.NET" Version="2025.1.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="buildTransitive\AditiKraft.Aspire.Hosting.RemoteDocker.props" Pack="true" PackagePath="buildTransitive\" />
    
  </ItemGroup>
</Project>
